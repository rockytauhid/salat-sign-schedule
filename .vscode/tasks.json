{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run SalatSign (Mosque Signage)",
      "type": "process",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/run-app.ps1",
        "salatsign"
      ],
      "problemMatcher": []
    },
    {
