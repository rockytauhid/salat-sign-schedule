<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV Leanback Requirements -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Strictly Silent Mosque Signage: NO audio, NO notifications, NO foreground service permissions -->
    <!-- Storage Permission for Direct USB / File Access on Android <= 12 (API <= 32) -->
    <!-- Android 13+ (API 33+) uses Storage Access Framework (SAF) without requiring broad media permissions -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Retained for optional local-network phone controller discovery/pairing; core signage is 100% offline -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Auto-launch signage kiosk + in-process Phone Controller after TV reboot when Always-On is enabled (D24) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".SalatSignApp"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/ic_tv_banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalatSign">

        <!-- Main Leanback TV Activity (Mosque Digital Signage) -->
        <!-- enableOnBackInvokedCallback="false" preserves physical TV remote 3-second Back-hold kiosk exit on Android 16 (R10-1) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="false"
            android:launchMode="singleTask"
            android:banner="@drawable/ic_tv_banner"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.SalatSign">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boot & package-replace receiver: auto-launches SalatSign when Always-On Phone Controller is enabled -->
        <receiver
            android:name=".remote.SalatSignBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
