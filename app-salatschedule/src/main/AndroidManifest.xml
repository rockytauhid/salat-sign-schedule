<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV Leanback Requirements -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Background Scheduling & Audio Services (Home Prayer Times & Adhan) -->
    <!-- Note: AlarmManager.setAlarmClock() does not require SCHEDULE_EXACT_ALARM or USE_EXACT_ALARM -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Storage Permission for Direct USB / File Access on Android <= 12 (API <= 32) -->
    <!-- Android 13+ (API 33+) uses Storage Access Framework (SAF) without requiring broad media permissions -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".SalatScheduleApp"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/ic_tv_banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalatSign">

        <!-- Main Leanback TV Activity (Home Prayer Schedule) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:banner="@drawable/ic_tv_banner"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.SalatSign">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Audio Playback Service for Exact Adhan Alerts -->
        <service
            android:name=".service.AdhanPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Alarm Receiver for Scheduled Prayer & Reminder Alarms -->
        <receiver
            android:name=".service.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- Boot & Time-Change Receiver for Alarm Recovery (system broadcasts only) -->
        <receiver
            android:name=".service.BootAndTimeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Android TV Screensaver (DreamService) — strictly silent, non-interactive -->
        <service
            android:name=".screensaver.SalatScreensaverService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/ic_tv_banner"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/screensaver" />
        </service>

        <!-- In-app Screensaver Preview Activity -->
        <activity
            android:name=".screensaver.ScreensaverPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.SalatSign" />

    </application>

</manifest>
