<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Drop Shadow under Clock Emblem -->
    <path
        android:fillColor="#33000000"
        android:pathData="M32,78 C32,78 40,82 54,82 C68,82 76,78 76,78 L77,82 C77,82 68,86 54,86 C40,86 31,82 31,82 Z" />

    <!-- Outer Emerald Clock Ring -->
    <path
        android:pathData="M54,26 A28,28 0 1,0 54,82 A28,28 0 1,0 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#1F5E41" android:offset="0.0" />
                <item android:color="#0F2E20" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Deep Dial -->
    <path
        android:fillColor="#081A12"
        android:pathData="M54,31 A23,23 0 1,0 54,77 A23,23 0 1,0 54,31 Z" />

    <!-- Subtle Emerald Rim Stroke -->
    <path
        android:strokeColor="#34D399"
        android:strokeWidth="1.8"
        android:fillColor="#00000000"
        android:pathData="M54,31 A23,23 0 1,0 54,77 A23,23 0 1,0 54,31 Z" />

    <!-- Cardinal Prayer Hour Ticks (12, 3, 6, 9) -->
    <path
        android:strokeColor="#FBBF24"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M54,34 L54,37.5 M74,54 L70.5,54 M54,74 L54,70.5 M34,54 L37.5,54" />

    <!-- Glowing Crescent Accent on Left Half of Dial -->
    <path
        android:pathData="M48,41 C41,44 38,52 41,59 C44,66 51,69 58,67 C53,67 48,64 46,59 C44,54 45,48 48,43 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="41"
                android:endX="58"
                android:endY="68"
                android:type="linear">
                <item android:color="#6EE7B7" android:offset="0.0" />
                <item android:color="#10B981" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Golden Clock Hands pointing to Prayer Time -->
    <path
        android:strokeColor="#FDE68A"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M54,54 L54,42 M54,54 L64,54" />

    <!-- Center Gold Pivot -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M54,51.2 A2.8,2.8 0 1,0 54,56.8 A2.8,2.8 0 1,0 54,51.2 Z" />

    <!-- Top Golden Star Accent -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M54,19 L55.4,21.8 L58.4,22.2 L56.2,24.2 L56.8,27.2 L54,25.7 L51.2,27.2 L51.8,24.2 L49.6,22.2 L52.6,21.8 Z" />

</vector>
